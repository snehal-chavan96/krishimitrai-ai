# Local Server Port (default 3000)
PORT=3000

# Optional: Local SQLite Database Path
SQLITE_DB_PATH=./data/krishimitra.db

# Optional: Local Ollama Configuration (zero API keys required)
# Start Ollama locally (`ollama serve` and `ollama pull qwen2.5:3b`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional: Ollama local embedding model (if unset, built-in local multilingual embeddings are used)
OLLAMA_EMBED_MODEL=
